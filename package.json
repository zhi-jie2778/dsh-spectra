{
  "name": "dsh-ui-beautify",
  "version": "1.7.4",
  "description": "界面美化 for DeepSeek Harness: a comprehensive, parameter-rich UI beautification suite with presets, custom themes, a wallpaper library, glass materials, motion effects, per-region and per-zone colours, and share codes.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "theme",
    "skin",
    "glassmorphism",
    "beautify",
    "appearance"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "test": "node test/smoke.mjs && node test/wallpaper.mjs && node test/render.mjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "test",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5"
  }
}
