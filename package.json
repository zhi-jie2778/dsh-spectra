{
  "name": "dsh-spectra",
  "version": "1.8.0",
  "description": "界面美化 for DeepSeek Harness: a comprehensive, parameter-rich UI beautification suite with presets, custom themes, a wallpaper library, glass materials, motion effects, per-region and per-zone colours, and share codes.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "spectra",
    "theme",
    "glassmorphism",
    "beautify",
    "appearance"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "test": "node test/smoke.mjs && node test/wallpaper.mjs && node test/render.mjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhi-jie2778/dsh-spectra.git"
  },
  "homepage": "https://github.com/zhi-jie2778/dsh-spectra#readme",
  "bugs": {
    "url": "https://github.com/zhi-jie2778/dsh-spectra/issues"
  },
  "files": [
    "lib",
    "test",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ]
}
